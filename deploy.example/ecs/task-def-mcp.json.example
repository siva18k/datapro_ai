{
  "family": "datapro-mcp",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "__MCP_TASK_CPU__",
  "memory": "__MCP_TASK_MEMORY__",
  "executionRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "mcp",
      "image": "__IMAGE_MCP__",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DB_SCHEMA", "value": "__DB_SCHEMA__" },
        { "name": "EMBEDDING_MODEL", "value": "__EMBEDDING_MODEL__" },
        { "name": "PGSSLMODE", "value": "__PGSSLMODE__" },
        { "name": "MCP_TRANSPORT", "value": "streamable-http" },
        { "name": "MCP_HOST", "value": "0.0.0.0" },
        { "name": "MCP_PORT", "value": "8000" },
        { "name": "MCP_PATH", "value": "/mcp" },
        { "name": "MCP_STATELESS", "value": "true" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "__SECRET_DATABASE_URL_ARN__" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP_MCP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "mcp"
        }
      }
    }
  ]
}
