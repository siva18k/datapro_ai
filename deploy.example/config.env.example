# Non-secret AWS deployment settings — safe to share in your team, still gitignored under deploy/
# Copy to deploy/config.env and edit. Do NOT put API keys or database passwords here.

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# --- ECR (created by create-aws-resources.sh or use your own names) ---
ECR_REPO_API=datapro-api
ECR_REPO_WEB=datapro-web
ECR_REPO_MCP=datapro-mcp

# --- ECS ---
ECS_CLUSTER=datapro
ECS_LAUNCH_TYPE=FARGATE

# Network (your VPC — replace with real IDs in deploy/config.env only)
ECS_SUBNETS=subnet-aaa,subnet-bbb
ECS_SECURITY_GROUPS=sg-aaa
ECS_ASSIGN_PUBLIC_IP=ENABLED

# Cloud Map / service discovery namespace for internal DNS (api.<namespace>)
ECS_SERVICE_DISCOVERY_NAMESPACE=datapro.local
API_SERVICE_NAME=api
WEB_SERVICE_NAME=web
MCP_SERVICE_NAME=mcp

# Web container: hostname the nginx proxy uses for API (Cloud Map name)
API_UPSTREAM_HOST=api.datapro.local

# Task sizing (Fargate CPU units and memory MiB)
TASK_CPU=1024
TASK_MEMORY=2048
MCP_TASK_CPU=512
MCP_TASK_MEMORY=1024

# Desired counts (0 to disable MCP)
DESIRED_COUNT_API=1
DESIRED_COUNT_WEB=1
DESIRED_COUNT_MCP=0

# ALB (optional — set CREATE_ALB=true in create-aws-resources.sh)
ALB_NAME=datapro
WEB_TARGET_GROUP=datapro-web
API_TARGET_GROUP=datapro-api

# Logging
LOG_GROUP_PREFIX=/ecs/datapro

# Application (non-secret)
DB_SCHEMA=ragpro
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_LLM_BACKEND=mistral
PGSSLMODE=require

# Secrets Manager ARNs (create with ./deploy/scripts/sync-secrets-to-aws.sh)
SECRET_PREFIX=datapro
SECRET_DATABASE_URL_ARN=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:datapro/database-url-XXXX
SECRET_MISTRAL_API_KEY_ARN=

# Optional ALB target group ARNs (for public access)
# WEB_TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:...
# API_TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:...

# Image tags
IMAGE_TAG=latest
