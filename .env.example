# Copy to .env and fill in your values (never commit .env):
#   cp .env.example .env
#
# Saved Postgres connections for datasets (optional, also gitignored):
#   cp saved_db_connections.json.example saved_db_connections.json
# See docs/secrets.md

# --- LLM (pick one provider in Settings UI) ---
MISTRAL_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""

DEFAULT_LLM_BACKEND="mistral"
# Mistral free tier: codestral-2508 (code/SQL), ministral-3b-2512 (fast chat), devstral-2512 (agents)
DEFAULT_LLM_MODEL="codestral-2508"
# Local LLM (no cloud key):
# DEFAULT_LLM_BACKEND="ollama"
OLLAMA_BASE_URL="http://localhost:11434"

# --- Embeddings (global; re-ingest after changing) ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# --- Ask (follow-up conversation context until New chat) ---
ASK_CONVERSATION_TURNS="5"
# RAG chunks retrieved per Ask query (1–8)
ASK_RETRIEVAL_TOP_K="3"

# --- Catalog database (metadata + RAG embeddings) ---
# REQUIRED: your own Postgres with pgvector. Not committed to git.
# Setup guide: docs/catalog-database.md
#
# Docker Compose defaults (bundled db service):
POSTGRES_USER="ragpro"
POSTGRES_PASSWORD="ragpro"
POSTGRES_DB="ragpro"
POSTGRES_PORT="5432"

# Used by API / migrate / MCP (Docker: host is "db")
DATABASE_URL="postgresql://ragpro:ragpro@localhost:5432/ragpro"
PGSSLMODE="disable"
DB_SCHEMA="ragpro"
# Catalog driver: psycopg (default, libpq) or pg8000 (pure Python fallback)
# CATALOG_DB_DRIVER="psycopg"

# --- Trino (business warehouse SQL — separate from catalog Postgres above) ---
# Docker Compose: TRINO_HOST=trino and TRINO_PORT=8080 inside the network; use localhost:8081 from the host.
TRINO_HOST="localhost"
TRINO_PORT="8081"
TRINO_USER="trino"
TRINO_PASSWORD=""
TRINO_HTTP_SCHEME="http"
TRINO_VERIFY_SSL="false"

# Or separate fields instead of DATABASE_URL (override URL parts):
# PGHOST="your-db-host.example.com"
# PGPORT=5432
# PGUSER="datapro_app"
# PGPASSWORD="your-password"
# PGDATABASE="datapro_catalog"

# --- MCP server (for Cursor / Claude Desktop) ---
MCP_URL="http://127.0.0.1:8000/mcp"
MCP_TRANSPORT="streamable-http"
MCP_HOST="127.0.0.1"
MCP_PORT="8000"
MCP_PATH="/mcp"

# --- Optional email MCP (seeded in MCP page; docker compose --profile integrations) ---
EMAIL_MCP_URL="http://127.0.0.1:8010/mcp"
EMAIL_MCP_PORT="8010"

# Transactional email (Resend, SendGrid, Mailgun, Gmail, AWS SES — all use SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS="true"

# Optional — only needed for search_inbox tool
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""

# Comma-separated recipients allowed for send_email (leave empty = no restriction)
EMAIL_TO_ALLOWLIST=""

# Provider examples (uncomment one block and fill in values):
#
# Resend — https://resend.com/docs/send-with-smtp
# SMTP_HOST="smtp.resend.com"
# SMTP_USER="resend"
# SMTP_PASSWORD="re_xxxxxxxx"
# SMTP_FROM="Analytics <reports@yourdomain.com>"
#
# SendGrid — https://docs.sendgrid.com/for-developers/sending-email/integrate-with-the-smtp-api
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_USER="apikey"
# SMTP_PASSWORD="SG.xxxxxxxx"
# SMTP_FROM="reports@yourdomain.com"
#
# Mailgun — https://documentation.mailgun.com/docs/mailgun/user-manual/sending-messages/send-smtp
# SMTP_HOST="smtp.mailgun.org"
# SMTP_USER="postmaster@mg.yourdomain.com"
# SMTP_PASSWORD="xxxxxxxx"
# SMTP_FROM="reports@yourdomain.com"
#
# Gmail (free dev) — https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="you@gmail.com"
# IMAP_HOST="imap.gmail.com"
# IMAP_USER="you@gmail.com"
# IMAP_PASSWORD="your-app-password"

# --- Docker Compose port overrides (optional) ---
API_PORT="8080"
WEB_PORT="5173"
