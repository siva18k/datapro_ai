# Copy to .env and fill in your values (never commit .env):
#   cp .env.example .env
#
# Saved Postgres connections for datasets (optional, also gitignored):
#   cp saved_db_connections.json.example saved_db_connections.json
# See docs/secrets.md

# --- LLM (pick one provider in Settings UI) ---
MISTRAL_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""

DEFAULT_LLM_BACKEND="mistral"
DEFAULT_LLM_MODEL=""
# Local LLM (no cloud key):
# DEFAULT_LLM_BACKEND="ollama"
OLLAMA_BASE_URL="http://localhost:11434"

# --- Embeddings (global; re-ingest after changing) ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# --- Catalog database (metadata + RAG embeddings) ---
# REQUIRED: your own Postgres with pgvector. Not committed to git.
# Setup guide: docs/catalog-database.md
#
# Docker Compose defaults (bundled db service):
POSTGRES_USER="ragpro"
POSTGRES_PASSWORD="ragpro"
POSTGRES_DB="ragpro"
POSTGRES_PORT="5432"

# Used by API / migrate / MCP (Docker: host is "db")
DATABASE_URL="postgresql://ragpro:ragpro@localhost:5432/ragpro"
PGSSLMODE="disable"
DB_SCHEMA="ragpro"

# Or separate fields instead of DATABASE_URL (override URL parts):
# PGHOST="your-db-host.example.com"
# PGPORT=5432
# PGUSER="datapro_app"
# PGPASSWORD="your-password"
# PGDATABASE="datapro_catalog"

# --- MCP server (for Cursor / Claude Desktop) ---
MCP_URL="http://127.0.0.1:8000/mcp"
MCP_TRANSPORT="streamable-http"
MCP_HOST="127.0.0.1"
MCP_PORT="8000"
MCP_PATH="/mcp"

# --- Docker Compose port overrides (optional) ---
API_PORT="8080"
WEB_PORT="5173"
